# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.

PORT=3070

# ---------------------------------------------------------------------
# Conexion principal: la misma base del sistema Laravel "salidas"
# (registros, destinos, folios, especials, iclock_transactions). Ambos
# sistemas pueden convivir durante la transicion.
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=adminplem_salidas

# ---------------------------------------------------------------------
# Padron centralizado: login (users_safs), personas (s_usuario, s_users),
# estructura (t_dependencia, t_direccion, t_departamento) y datos de
# contacto (s_datosGeneralesUsr).
# ---------------------------------------------------------------------
DB_EXTERNAL_HOST=
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_USERNAME=
DB_EXTERNAL_PASSWORD=
DB_EXTERNAL_DATABASE=adminplem_saf

# ---------------------------------------------------------------------
# Directorio de edificios (tabla ubicaciones). Solo lectura.
# ---------------------------------------------------------------------
DB_DIRECTORIO_HOST=
DB_DIRECTORIO_PORT=3306
DB_DIRECTORIO_USERNAME=
DB_DIRECTORIO_PASSWORD=
DB_DIRECTORIO_DATABASE=adminplem_directorio

# ---------------------------------------------------------------------
# Checadores biometricos (iclock_transaction, personnel_employee). Solo lectura.
# ---------------------------------------------------------------------
DB_CHECADORES_HOST=
DB_CHECADORES_PORT=3306
DB_CHECADORES_USERNAME=
DB_CHECADORES_PASSWORD=
DB_CHECADORES_DATABASE=checadores

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# ---------------------------------------------------------------------
# Lectura de checadores y cierre de permisos vencidos.
# Dejalo en false mientras siga activo el cron de Laravel (permiso:users):
# si ambos corren a la vez se duplican los avisos al jefe.
# ---------------------------------------------------------------------
CHECADAS_ACTIVO=false

# ---------------------------------------------------------------------
# Correo. Mientras CORREO_ACTIVO no sea true solo se registra en el log lo
# que se habria enviado; dejalo en false en local y en pruebas.
# ---------------------------------------------------------------------
CORREO_ACTIVO=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notifintra@legislativoedomex.gob.mx
# Direccion publica del sistema: es el boton "Ingresar" de los correos.
APP_URL=https://siasaf.gob.mx/salidas
